rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Same rules you'll deploy to production (see tools/firestore-rules-recommended.txt).
    // The seed script creates a staff login (admin@blackstars.qa / admin123) in the
    // Auth emulator so the app can sign in and write.
    // A MEMBER portal login is `<mobile>@blackstars.com` — the local part is all
    // DIGITS. STAFF (receptionist/admin) use the SAME domain with a NAMED local part
    // (receptionist@…, test@…), so match ONLY a digit local part — otherwise staff
    // would be denied the club's data (0 invoices, etc.).
    // The Users & Roles map lives on the parent meta doc (settings.userRoles), keyed by
    // LOWER-CASED email. A digit-only email that the admin mapped to a STAFF role
    // (coach / admin / receptionist) is NOT a member — e.g. a coach onboarded as
    // <mobile>@blackstars.com. `.get(k, default)` guards a missing settings/map/entry.
    function _userRoles() {
      return get(/databases/$(database)/documents/clubs/blackstars).data
        .get('settings', {}).get('userRoles', {});
    }
    function _mappedRole() {
      return (request.auth != null && request.auth.token.email != null
              && (request.auth.token.email.lower() in _userRoles()))
        ? _userRoles()[request.auth.token.email.lower()].get('role', '') : '';
    }
    function isMappedStaff() {
      return _mappedRole() in ['coach', 'admin', 'receptionist'];
    }
    // v6.870 — EFFECTIVE ROLE, the same decision app.js roleForEmail makes:
    //   1. the admin's role map (settings.userRoles) wins;
    //   2. a mobile-number login (digits@blackstars.com / members.blackstars.qa) is a MEMBER;
    //   3. an empty role map = a brand-new club: the first login is the admin (bootstrap);
    //   4. any OTHER login the admin never mapped gets settings.unmappedRole — 'student' unless the admin chose otherwise.
    // Before this, step 4 did not exist: a member who signed in with a real e-mail counted as FULL STAFF on the server.
    function _digitLogin() {
      return request.auth.token.email.matches('^[0-9]+@(blackstars[.]com|members[.]blackstars[.]qa)$');
    }
    function _unmappedRole() {
      return get(/databases/$(database)/documents/clubs/blackstars).data
        .get('settings', {}).get('unmappedRole', 'student');
    }
    function effRole() {
      return (request.auth == null || request.auth.token.email == null) ? 'none'
        : isMappedStaff() ? _mappedRole()
        : _digitLogin() ? 'student'
        : (_userRoles().size() == 0) ? 'admin'
        : _unmappedRole();
    }
    function isMember() {
      return request.auth != null && !(effRole() in ['admin', 'receptionist', 'coach']);
    }
    function isStaff() {
      return request.auth != null && !isMember();
    }
    function isAdmin() {
      return effRole() == 'admin';
    }
    function isReception() {
      return effRole() == 'receptionist';
    }

    // ── COACH ROLE (v6.739) ─────────────────────────────────────────────────────────────────
    // A login the role map (settings.userRoles) marks 'coach' is NOT full staff. It may read and write
    // ONLY records stamped with its own coach ids (`coachIds`, written by the app's stamp pass), plus
    // the shared 'M' stamp that marks a live Mixed member / Mixed invoice (any coach may mark Mixed).
    // Admin / receptionist / any other staff login keeps exactly the access it had (isFullStaff()).
    function isCoach() {
      return effRole() == 'coach';
    }
    function isFullStaff() {
      return request.auth != null && !isMember() && !isCoach();
    }
    function _myCoachIds() {
      let r = _userRoles()[request.auth.token.email.lower()];
      return (r.get('coachIds', []).size() > 0) ? r.get('coachIds', []) : [r.get('coachId', -1)];
    }
    function coachMine(d) {
      return d.get('coachIds', []).hasAny(_myCoachIds());
    }
    function coachMineOrMixed(d) {
      return d.get('coachIds', []).hasAny(_myCoachIds().concat(['M']));
    }
    function coachCanRead(collection, d) {
      return (collection in ['members', 'invoices']) ? coachMineOrMixed(d)
        : (collection in ['schedule', 'trials', 'salaries', 'advices', 'posts', 'expenses']) ? coachMine(d)
        : (collection == 'coaches') ? (d.get('id', -1) in _myCoachIds())
        : false;
    }
    // A coach may add his own advice / posts / trials (stamped with his id) — never members, invoices, anything else.
    function coachCanCreate(collection, nd) {
      return (collection in ['advices', 'posts', 'trials']) && coachMine(nd);
    }
    // Updates keep the stamp untouched (a coach cannot hand a record to another coach or claim one).
    // On a member a coach may change ONLY what marking attendance touches: the two attendance maps, the
    // package/renewal rows whose counters and first-class start date it moves, the dates/status derived from
    // them, and the who/when stamp. Name, phone, QID, family, notes, … are not his to edit.
    function coachMemberFieldsOnly(od, nd) {
      return nd.diff(od).affectedKeys().hasOnly(['dailyAttendance', 'mixedAttendance', 'subscriptions', 'renewals',
        'enrollments', 'startDate', 'expiryDate', 'status', 'months', 'updatedAt', 'updatedBy', 'updatedByName',
        'createdAt', 'createdBy', 'createdByName']);
    }
    function coachCanUpdate(collection, od, nd) {
      return nd.get('coachIds', []) == od.get('coachIds', [])
        && (((collection == 'members') && coachMineOrMixed(od) && coachMemberFieldsOnly(od, nd))
            || ((collection in ['advices', 'posts', 'trials']) && coachMine(od)));
    }
    // The ROLE MAP (settings.userRoles) decides who is admin/receptionist/coach. If ANY staff
    // could rewrite it, a receptionist could promote themselves to admin or lock everyone out —
    // a privilege-escalation hole. This returns true when a write leaves the role map untouched,
    // so only a change TO the role map is gated on isAdmin() below. resource == null on the very
    // first create of the club doc; a create that already carries a role map must be an admin.
    function _rolesUnchanged() {
      return (resource != null
              ? resource.data.get('settings', {}).get('userRoles', {})
              : {})
        == request.resource.data.get('settings', {}).get('userRoles', {});
    }
    // BOOTSTRAP: on a brand-new club the role map is empty and NOBODY is admin yet (the app treats
    // the first login as admin — see roleForEmail). So the first-ever role map may be set by any
    // staff; once ANY mapping exists this is false and only an admin can change it. Matches the app,
    // and does not weaken a live club (whose map is already populated).
    function _rolesEmptyBefore() {
      return (resource == null)
        || resource.data.get('settings', {}).get('userRoles', {}).size() == 0;
    }
    // Collections a MEMBER portal login may read. Everything else — invoices/
    // revenue, expenses, salaries, cashCounts, sales, coaches (pay), families,
    // membershipTransfers, notes, rentals, trials, drivers, products, auditLog — is
    // denied to members. Staff read/write everything.
    function memberReadable(collection) {
      return collection in ['members', 'schedule', 'advices', 'posts', 'swimGroups'];
    }
    // v6.870 — the roster is NOT open to every member any more. A member reads only the member record(s) the app has
    // stamped with that person's login keys (`loginKeys`: the phone digits in the usual forms + the e-mail, written by the
    // staff app's stamp pass). The keys the portal queries with are exactly [<local part of the login>, <the login e-mail>].
    function _myLoginKeys() {
      return [request.auth.token.email.lower().split('@')[0], request.auth.token.email.lower()];
    }
    function memberOwns(d) {
      return d.get('loginKeys', []).hasAny(_myLoginKeys());
    }
    function memberCanRead(collection, d) {
      return memberReadable(collection) && (collection != 'members' || memberOwns(d));
    }
    // v6.870 — what a RECEPTIONIST may not touch on the server: pay (the salaries collection), hard deletes of money records
    // (invoices / expenses / salaries / sales — the app soft-deletes, so a real delete is tampering) and the safeguard settings.
    function recepBlocked(collection) {
      return isReception() && collection in ['salaries', 'coaches'];   // v6.872 — coaches carry the pay fields (rate, fixedSalary…); reception reads the pay-free staffDirectory instead
    }
    // v6.872 — the pay-free staff list (name, role, active, sports, contact…) is written by the admin's app only
    function recepNoWrite(collection) {
      return isReception() && collection == 'staffDirectory';
    }
    // v6.872 — expense rows a receptionist must not see: salaries, rent, the auto bank-commission / Citadel rows, the owner's net-profit row.
    // The check is a PLAIN `in` on resource.data.category (a get(…, default) here would let a plain list slip through — verified in the emulator);
    // the reception app reads with the matching query where('category','not-in',[…]).
    function expenseHiddenFromReception(d) {
      return d.category in ['Salary', 'salary', 'Salaries', 'Rent', 'rent', 'Bank Commission', 'Citadel Company Share', 'Owner Net Profit', 'Advertising'];
    }
    function recepCanReadDoc(collection, d) {
      return !(isReception() && collection == 'expenses') || !expenseHiddenFromReception(d);
    }
    function recepNoDelete(collection) {
      return isReception() && collection in ['invoices', 'expenses', 'salaries', 'sales'];
    }
    function _setting(d, k) {
      return d.get('settings', {}).get(k, null);
    }
    function _protectedSettingsUnchanged() {
      return resource == null || (
        _setting(resource.data, 'lockedThrough') == _setting(request.resource.data, 'lockedThrough')
        && _setting(resource.data, 'systemPinHash') == _setting(request.resource.data, 'systemPinHash')
        && _setting(resource.data, 'auditEnabled') == _setting(request.resource.data, 'auditEnabled')
        && _setting(resource.data, 'unmappedRole') == _setting(request.resource.data, 'unmappedRole'));
    }

    match /clubs/{clubId} {
      allow read:  if request.auth != null;   // parent meta doc (settings / camp schedule)
      // Staff may write the club meta doc (settings, camp schedule, sport list, prices…), BUT
      // changing the ROLE MAP is admin-only — otherwise any staff login could escalate itself.
      // A coach never writes the club meta doc (settings, prices, the role map…).
      allow write: if isFullStaff() && (_rolesUnchanged() || isAdmin() || _rolesEmptyBefore())
                   && (!isReception() || _protectedSettingsUnchanged());   // v6.870 — reception cannot lift the month lock, change the PIN, the audit switch or the default role

      // AUDIT TRAIL is IMMUTABLE (req #8): STAFF may CREATE + READ audit entries, but
      // NOBODY may update or delete, and MEMBERS may not read it at all. Declared
      // BEFORE the generic rule (Firestore grants if ANY rule matches).
      // A coach may only CREATE its own trail entries (every change is audited) — never read the trail.
      match /auditLog/{docId} {
        allow read:   if isFullStaff();
        allow create: if isStaff();
        allow update, delete: if false;
      }

      // v6.611 — Logins Logs Audit. ANY signed-in user (incl. members) records their OWN sign-in,
      // so all logins are captured; only STAFF can read the log; append-only (no edits/deletes).
      match /loginLogs/{docId} {
        allow read:   if isFullStaff();
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      // Every OTHER per-record subcollection: full staff read/write; members read ONLY
      // the portal collections (memberReadable) — the club's financial/operational
      // data is never exposed to a member login; a COACH reads/writes only his own stamped records.
      match /{collection}/{docId} {
        allow read:   if (isFullStaff() && !recepBlocked(collection) && recepCanReadDoc(collection, resource.data)) || (isMember() && memberCanRead(collection, resource.data))
                      || (isCoach() && coachCanRead(collection, resource.data));
        // v6.634 (#13) — exclude loginLogs too (like auditLog): the specific match above makes it
        // append-only, but Firestore UNIONS rules, so this generic write would otherwise re-grant staff
        // update/delete on the login audit. Keep both append-only logs out of the generic write.
        allow create: if (isFullStaff() && !recepBlocked(collection) && !recepNoWrite(collection) && collection != 'auditLog' && collection != 'loginLogs')
                      || (isCoach() && coachCanCreate(collection, request.resource.data));
        allow update: if (isFullStaff() && !recepBlocked(collection) && !recepNoWrite(collection) && collection != 'auditLog' && collection != 'loginLogs')
                      || (isCoach() && coachCanUpdate(collection, resource.data, request.resource.data));
        allow delete: if (isFullStaff() && !recepBlocked(collection) && !recepNoWrite(collection) && !recepNoDelete(collection) && collection != 'auditLog' && collection != 'loginLogs')
                      || (isCoach() && (collection in ['advices', 'posts', 'trials']) && coachMine(resource.data));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
